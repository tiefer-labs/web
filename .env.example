# Tiefer website configuration. Copy to .env for local development
# (make run loads it; quote values that contain spaces). In production,
# set these as environment variables on the host or container. Never
# commit real secrets.

# HTTP port the server listens on.
PORT=8080

# "development" or "production". Production requires SITE_URL (https),
# CONTACT_EMAIL and CSRF_SECRET, and logs as JSON.
ENV=development

# Canonical base URL, without a trailing slash. Used for canonical links,
# Open Graph, the sitemap and robots.txt.
SITE_URL=http://localhost:8080

# Public contact address, shown on the site and used for mailto: links.
CONTACT_EMAIL=hello@example.com

# LinkedIn company page.
LINKEDIN_URL=https://www.linkedin.com/company/tiefer

# Public source repository. The footer link "Source code" appears only
# when this is set.
REPO_URL=

# Set to true only when the server runs behind one reverse proxy that
# appends the client address to X-Forwarded-For (used for rate limiting).
TRUST_PROXY=false

# Contact form mail delivery. TLS is required: port 465 uses implicit TLS,
# any other port must offer STARTTLS. If SMTP_HOST, CONTACT_TO or
# CONTACT_FROM is empty, the form is hidden and only "Email us" is shown.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where form messages are delivered.
CONTACT_TO=
# Sender address of form messages (Reply-To is set to the visitor).
CONTACT_FROM=
# Development only: accept a self-signed certificate from a local SMTP
# catcher such as Mailpit. Refused in production.
SMTP_SKIP_VERIFY=false

# Signing key for contact form tokens, at least 32 characters.
# Required in production. Generate one with: openssl rand -hex 32
# In development a random key is used when this is empty.
CSRF_SECRET=

# Company details for the legal pages. Until they are set, clearly marked
# placeholders are shown. Do not invent values.
LEGAL_NAME=[COMPANY_LEGAL_NAME]
# For example: MMC (limited liability company under the laws of the Republic of Azerbaijan)
LEGAL_FORM=[LEGAL_FORM]
LEGAL_ADDRESS=[REGISTERED_ADDRESS_BAKU]
# Tax identification number (VOEN).
LEGAL_TAX_ID=[VOEN]
LEGAL_REGISTRATION=[STATE_REGISTRATION_DETAILS]
LEGAL_DIRECTOR=[MANAGING_DIRECTOR]
LEGAL_HOSTING_PROVIDER=[HOSTING_PROVIDER]
LEGAL_HOSTING_COUNTRY=[HOSTING_COUNTRY]
LEGAL_SMTP_PROVIDER=[SMTP_PROVIDER]
LEGAL_SMTP_COUNTRY=[SMTP_COUNTRY]

# Set to true after a lawyer has reviewed the legal pages. While false,
# every legal page shows "Placeholder text. To be reviewed before launch."
LEGAL_REVIEWED=false

# Optional: "debug" also logs health checks.
LOG_LEVEL=info
