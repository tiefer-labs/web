# Tiefer website configuration. Copy to .env for local development
# (make run loads it; quote values that contain spaces). In production,
# set these as environment variables on the host or container. Never
# commit real secrets.

# HTTP port the server listens on.
PORT=8080

# "development" or "production". Production requires CSRF_SECRET, serves
# only the host of SITE_URL (tiefer.space), and logs as JSON.
ENV=development

# Canonical base URL, without a trailing slash. Used for canonical links,
# Open Graph, the sitemap and robots.txt.
# In production it defaults to https://tiefer.space.
SITE_URL=http://localhost:8080

# Public contact address, shown on the site and used for mailto: links.
# Default: hello@tiefer.space.
CONTACT_EMAIL=hello@tiefer.space

# Address for vulnerability reports, published in
# /.well-known/security.txt. Empty means CONTACT_EMAIL.
SECURITY_EMAIL=

# LinkedIn company page. Default: https://www.linkedin.com/company/tiefer.
LINKEDIN_URL=https://www.linkedin.com/company/tiefer

# Public source repository, linked as "Source code" in the footer.
# Default: https://github.com/tiefer-labs/web. Set it to empty to hide the link.
REPO_URL=https://github.com/tiefer-labs/web

# Set to true only when the server runs behind one reverse proxy that
# appends the client address to X-Forwarded-For (used for rate limiting).
TRUST_PROXY=false

# Contact form mail delivery. TLS is required: port 465 uses implicit TLS,
# any other port must offer STARTTLS. Without SMTP_HOST the form is hidden
# and only "Email us" is shown.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where form messages are delivered. Default: CONTACT_EMAIL.
CONTACT_TO=
# Sender address of form messages (Reply-To is set to the visitor).
# Default: website@tiefer.space.
CONTACT_FROM=
# Development only: accept a self-signed certificate from a local SMTP
# catcher such as Mailpit. Refused in production.
SMTP_SKIP_VERIFY=false

# Signing key for contact form tokens, at least 32 characters.
# Required in production. Generate one with: openssl rand -hex 32
# In development a random key is used when this is empty.
CSRF_SECRET=

# Who operates the site, for the legal pages. Tiefer is not yet registered
# as a company, so the founder operates it as a private individual.
LEGAL_FOUNDER=[FOUNDER_NAME]

# Company details, only once the company is registered. Setting LEGAL_NAME
# switches the legal pages from the founder to the company, and then every
# value below is required. Do not invent values.
LEGAL_NAME=
# For example: MMC (limited liability company under the laws of the Republic of Azerbaijan)
LEGAL_FORM=
LEGAL_ADDRESS=
# Tax identification number (VOEN).
LEGAL_TAX_ID=
LEGAL_REGISTRATION=
LEGAL_DIRECTOR=

# Hosting and mail providers, named in the privacy notice. Until they are
# set, clearly marked placeholders are shown.
LEGAL_HOSTING_PROVIDER=[HOSTING_PROVIDER]
LEGAL_HOSTING_COUNTRY=[HOSTING_COUNTRY]
LEGAL_SMTP_PROVIDER=[SMTP_PROVIDER]
LEGAL_SMTP_COUNTRY=[SMTP_COUNTRY]

# Set to true after a lawyer has reviewed the legal pages. While false,
# every legal page shows "Placeholder text. To be reviewed before launch."
LEGAL_REVIEWED=false

# Optional: "debug" also logs health checks.
LOG_LEVEL=info

# Deployment only (deploy/docker-compose.yml): address Let's Encrypt uses
# for certificate notices. Default: hello@tiefer.space.
ACME_EMAIL=
