# Configuration of the Tiefer website. Copy to .env.local for local use and never commit real values.
# CONFIGURATION.md says what to set for local use, the contact form, Vercel and Azure.
# Pages are prerendered at build time, so everything they show (site URL, contact details, legal details) must be
# set when `pnpm build` runs. Secrets (CSRF_SECRET, SMTP_PASS) are only needed by the running server; on Azure they
# come from Key Vault (see infra/README.md).

# development or production. Only production is indexed by search engines.
ENV=development

# Canonical base URL, scheme and host only. Production: https://tiefer.space
SITE_URL=http://localhost:3000

# Public contact address and mailto link.
CONTACT_EMAIL=hello@tiefer.space

# LinkedIn company page.
LINKEDIN_URL=https://www.linkedin.com/company/tiefer/

# Public source repository, linked in the footer when set.
REPO_URL=

# Mail server for the contact form. Empty hides the form and shows an "Email us" button.
SMTP_HOST=

# 465 uses implicit TLS; any other port must offer STARTTLS.
SMTP_PORT=587

# SMTP user name.
SMTP_USER=

# SMTP password. In production it comes from Azure Key Vault.
SMTP_PASS=

# Where contact form messages are delivered.
CONTACT_TO=

# Sender address of contact form messages.
CONTACT_FROM=

# Development only: accept the self-signed certificate of a local SMTP catcher such as Mailpit. Refused in production.
SMTP_SKIP_VERIFY=false

# Signing key for form tokens, at least 32 characters (openssl rand -hex 32). Required in production; random in
# development.
CSRF_SECRET=

# Shared store for contact form rate limits and used tokens. Without either, they live in memory, which is only
# correct with a single server instance. Use Redis on Vercel or with more than one instance.
# Upstash over REST (Vercel):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Any Redis over TCP, for example a Docker container: redis://localhost:6379
REDIS_URL=

# Company legal name.
LEGAL_NAME=[COMPANY_LEGAL_NAME]

# Legal form, for example MMC (limited liability company under the laws of the Republic of Azerbaijan).
LEGAL_FORM=[LEGAL_FORM]

# Registered address in Baku.
LEGAL_ADDRESS=[REGISTERED_ADDRESS_BAKU]

# Tax identification number (VOEN).
LEGAL_TAX_ID=[VOEN]

# State registration details.
LEGAL_REGISTRATION=[STATE_REGISTRATION_DETAILS]

# Managing director.
LEGAL_DIRECTOR=[MANAGING_DIRECTOR]

# Hosting provider, named in the privacy notice.
LEGAL_HOSTING_PROVIDER=[HOSTING_PROVIDER]

# Country where the site is hosted.
LEGAL_HOSTING_COUNTRY=[HOSTING_COUNTRY]

# Email provider, named in the privacy notice.
LEGAL_SMTP_PROVIDER=[SMTP_PROVIDER]

# Country of the email provider.
LEGAL_SMTP_COUNTRY=[SMTP_COUNTRY]

# true only after a lawyer has reviewed the legal pages.
LEGAL_REVIEWED=false

# Shown on the privacy page; must match the Azure log retention.
LOG_RETENTION_DAYS=30

# true on Azure: requests must carry the Front Door ID, and the client address comes from Front Door.
BEHIND_FRONT_DOOR=false

# The Front Door profile ID. Required when BEHIND_FRONT_DOOR=true in production.
FRONT_DOOR_ID=

# Adds preload to Strict-Transport-Security. Founder decision.
HSTS_PRELOAD=false
