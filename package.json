    "@vitest/coverage-v8": "5.0.4",
    "babel-plugin-react-compiler": "1.0.0",
    "d3-geo": "3.1.1",
    "greenly": "1.2.0",
    "jsdom": "30.1.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "tailwindcss": "4.3.3",
    "topojson-client": "3.1.0",
